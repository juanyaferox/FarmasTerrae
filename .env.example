# =============================================================================
# FarmasTerrae Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# `.env` is gitignored and excluded from the Docker build context: never commit it.
#
# Modes:
#   - Local Docker + MinIO: docker compose -f docker-compose.help.yml up --build
#       (profile is fixed to `prodminio`; SPRING_PROFILES_ACTIVE, AWS_REGION and AWS_BUCKET are ignored)
#   - Production / AWS:     docker compose up --build -d
#       (requires the variables below + TLS files in ./ssl/, see docs/env-vars-for-prod.md)
# =============================================================================

# --- Spring Profile (production / AWS only) ---
# Leave as `prod` for docker-compose.yml. Ignored by docker-compose.help.yml (`prodminio`).
SPRING_PROFILES_ACTIVE=prod

# --- Security ---
# Secret key used to sign 7-day remember-me cookies (required in `prod`).
# Generate one with: openssl rand -base64 48
SECRET_KEY=change-me-to-a-long-random-secret

# --- MySQL Database ---
DB_NAME=farmasterrae
DB_HOST=db
DB_PORT=3306
DB_USERNAME=farmasterrae_user
DB_PASSWORD=change-me-strong-password
# Password of the MySQL `root` account inside the container (the app never uses it).
# Use a different value from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=change-me-different-root-password
# Optional overrides (keep them commented out to use the defaults):
# JDBC TLS mode: PREFERRED (default, works with the bundled MySQL container), REQUIRED,
# VERIFY_CA or VERIFY_IDENTITY (recommended for managed databases such as Amazon RDS).
# DB_SSL_MODE=PREFERRED
# Hibernate schema handling in `prod` (default `update`, so a fresh database can boot).
# Switch to `validate` once the schema exists.
# HIBERNATE_DDL_AUTO=update

# --- Initial administrator (production / AWS only) ---
# `prod` seeds only the ADMIN/USER profiles, never demo accounts. If all three values are set and
# no ADMIN user exists yet, this account is created on startup. The password must follow the user
# password rules (currently 6-20 letters or digits, at least one uppercase letter and one digit).
# Clear these values after the first successful start.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Gmail SMTP (Password Recovery) ---
# Optional for local testing (password recovery emails will fail if omitted).
# Use a Google App Password, not your regular Gmail password.
EMAIL=your-email@gmail.com
PASSWORD=your-gmail-app-password

# --- AWS S3 (Production / `prod` profile only) ---
# In `prod`, credentials are resolved automatically via the AWS default credentials chain
# (e.g. EC2/ECS IAM instance role). No static AWS access keys are needed in production.
AWS_REGION=us-east-1
AWS_BUCKET=farmasterrae-bucket

# --- MinIO (Local Docker stack / docker-compose.help.yml only) ---
# Root credentials of the local MinIO server, also used by the app as its S3 keys.
# MINIO_ROOT_PASSWORD needs at least 8 characters (defaults: minioadmin / minioadmin).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
# Address the browser uses to download presigned product images.
AWS_PUBLIC_ENDPOINT=http://localhost:9000
