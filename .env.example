# =============================================================================
# FarmasTerrae Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Modes:
#   - Local Docker + MinIO: docker compose -f docker-compose.help.yml up --build
#       (profile is fixed to `prodminio`; AWS_* and SPRING_PROFILES_ACTIVE are ignored)
#   - Production / AWS:     docker compose up --build
#       (requires all variables below + TLS certs in ./ssl/)
# =============================================================================

# --- Spring Profile (production / AWS only) ---
# Leave as `prod` for docker-compose.yml. Ignored by docker-compose.help.yml (`prodminio`).
SPRING_PROFILES_ACTIVE=prod

# --- Security ---
# Secret key used to sign 7-day remember-me cookies
SECRET_KEY=change-me-to-a-long-random-secret

# --- MySQL Database ---
DB_NAME=farmasterrae
DB_HOST=db
DB_PORT=3306
DB_USERNAME=farmasterrae_user
DB_PASSWORD=change-me-strong-password

# --- Gmail SMTP (Password Recovery) ---
# Optional for local testing (password recovery emails will fail if omitted).
# Use a Google App Password, not your regular Gmail password.
EMAIL=your-email@gmail.com
PASSWORD=your-gmail-app-password

# --- AWS S3 (Production / `prod` profile only) ---
# In `prod`, credentials are resolved automatically via AWS DefaultCredentialsProvider
# (e.g. EC2/ECS IAM instance role). No static AWS access keys are needed in production.
AWS_REGION=us-east-1
AWS_BUCKET=farmasterrae-bucket
